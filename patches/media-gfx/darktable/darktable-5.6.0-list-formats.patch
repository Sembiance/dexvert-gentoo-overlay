+static void list_formats(void)
+{
+  printf("supported input formats:\n\n  %-10s %s\n", "extension", "type");
+  printf("  %-10s %s\n", "---------", "-------------");
+  for(const char **extension = dt_supported_extensions; *extension; extension++)
+  {
+    const dt_image_flags_t type = dt_imageio_get_type_from_extension(*extension);
+    const char *name = type & DT_IMAGE_RAW ? "RAW"
+                     : type & DT_IMAGE_HDR ? "HDR"
+                     : type & DT_IMAGE_LDR ? "LDR"
+                                           : "auto-detected";
+    printf("  .%-9s %s\n", *extension, name);
+  }
+}
