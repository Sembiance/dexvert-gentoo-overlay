+int ScribusCore::initFormats()
+{
+	CommonStrings::languageChange();
+	LanguageManager::instance()->languageChange();
+	if (!m_prefsManager.prefsFile)
+		m_prefsManager.prefsFile = new PrefsFile();
+	pluginManager = new PluginManager(true);
+	pluginManager->initPlugs();
+	return EXIT_SUCCESS;
+}
