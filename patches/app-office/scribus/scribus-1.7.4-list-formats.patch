+void ScribusQApp::showFormats()
+{
+	QFile output;
+	if (!output.open(stdout, QIODevice::WriteOnly))
+		return;
+
+	QTextStream ts(&output);
+	PluginManager* pluginManager = ScCore->pluginManager;
+	const QStringList pluginNames = pluginManager->pluginNames(true);
+	auto pluginNameFor = [pluginManager, &pluginNames](const ScPlugin* plugin) {
+		for (const QString& pluginName : pluginNames)
+		{
+			if (pluginManager->getPlugin(pluginName, true) == plugin)
+				return pluginName;
+		}
+		return QString();
+	};
+	auto printableList = [](QStringList values) {
+		values.removeAll(QString());
+		return values.isEmpty() ? QStringLiteral("(none declared)") : values.join(", ");
+	};
+	auto imageCodecNames = [](const QList<QByteArray>& codecs) {
+		QStringList result;
+		for (const QByteArray& codec : codecs)
+			result.append(QString::fromLatin1(codec).toLower());
+		result.removeDuplicates();
+		result.sort(Qt::CaseInsensitive);
+		return result;
+	};
+
+	ts << tr("Scribus %1 supported file formats").arg(VERSION) << Qt::endl;
+	ts << tr("Plugin directory: %1").arg(ScPaths::instance().pluginDir()) << Qt::endl;
+	ts << tr("The lists below reflect this build and the plugins/codecs available at runtime.") << Qt::endl;
+	Qt::endl(ts);
+
+	const QList<FileFormat>& fileFormats = LoadSavePlugin::supportedFormats();
+	ts << tr("Document and vector format handlers (%1)").arg(fileFormats.count()) << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	for (const FileFormat& format : fileFormats)
+	{
+		QStringList capabilities;
+		if (format.load)
+			capabilities.append(tr("load/open"));
+		if (format.save)
+			capabilities.append(tr("save"));
+		if (format.thumb)
+			capabilities.append(tr("thumbnail"));
+		if (format.colorReading)
+			capabilities.append(tr("color/palette import"));
+		if (format.nativeScribus)
+			capabilities.append(tr("native Scribus"));
+
+		ts << "- " << (format.trName.isEmpty() ? tr("(unnamed format)") : format.trName) << Qt::endl;
+		ts << "  " << tr("Capabilities: %1").arg(printableList(capabilities)) << Qt::endl;
+		ts << "  " << tr("Extensions: %1").arg(printableList(format.fileExtensions)) << Qt::endl;
+		ts << "  " << tr("MIME types: %1").arg(printableList(format.mimeTypes)) << Qt::endl;
+		ts << "  " << tr("Format ID: %1; priority: %2").arg(format.formatId).arg(format.priority) << Qt::endl;
+		const QString pluginName = pluginNameFor(format.plug);
+		if (!pluginName.isEmpty())
+			ts << "  " << tr("Plugin: %1").arg(pluginName) << Qt::endl;
+		if (!format.filter.isEmpty())
+			ts << "  " << tr("File-dialog filter: %1").arg(format.filter) << Qt::endl;
+	}
+	Qt::endl(ts);
+
+	FormatsManager* formatsManager = FormatsManager::instance();
+	const QStringList imageFilters = formatsManager
+		->fileDialogFormatList(FormatsManager::IMAGESIMGFRAME)
+		.split(QStringLiteral(";;"), Qt::SkipEmptyParts);
+	ts << tr("Image-frame import formats") << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	for (int i = 1; i + 1 < imageFilters.count(); ++i)
+		ts << "- " << imageFilters.at(i) << Qt::endl;
+	ts << tr("Qt image-reader codecs: %1")
+		.arg(printableList(imageCodecNames(QImageReader::supportedImageFormats()))) << Qt::endl;
+	ts << tr("Pattern resource import: %1")
+		.arg(formatsManager->extensionsForFormat(FormatsManager::PAT)) << Qt::endl;
+	Qt::endl(ts);
+
+	gtGetText textImporters(nullptr);
+	ts << tr("Text import formats (%1)").arg(textImporters.importers().size()) << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	for (const ImporterData& importer : textImporters.importers())
+	{
+		ts << "- " << importer.fileFormatName << Qt::endl;
+		ts << "  " << tr("Extensions: %1").arg(printableList(importer.fileEndings)) << Qt::endl;
+		ts << "  " << tr("Plugin: %1").arg(QFileInfo(importer.soFilePath).fileName()) << Qt::endl;
+	}
+	Qt::endl(ts);
+
+	ts << tr("Color and swatch import formats") << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	ts << "- " << tr("Adobe/AutoCAD Color Book") << Qt::endl;
+	ts << "  " << tr("Extensions: acb; implementation selected from file contents") << Qt::endl;
+	ts << "- " << tr("Adobe Color Swatch") << Qt::endl;
+	ts << "  " << tr("Extensions: aco") << Qt::endl;
+	ts << "- " << tr("Adobe Swatch Exchange") << Qt::endl;
+	ts << "  " << tr("Extensions: ase") << Qt::endl;
+	ts << "- " << tr("Color eXchange Format") << Qt::endl;
+	ts << "  " << tr("Extensions: cxf") << Qt::endl;
+	ts << "- " << tr("sK1 palette") << Qt::endl;
+	ts << "  " << tr("Extensions: skp") << Qt::endl;
+	ts << "- " << tr("SwatchBooker") << Qt::endl;
+	ts << "  " << tr("Extensions: sbz") << Qt::endl;
+	ts << "- " << tr("PostScript named colors") << Qt::endl;
+	ts << "  " << tr("Extensions: eps, epsf, epsi, eps2, eps3, epi, ept, ps") << Qt::endl;
+	ts << "- " << tr("Scribus/OpenOffice/Viva XML and GIMP text palettes") << Qt::endl;
+	ts << "  " << tr("Extensions: sla, soc, xml, gpl") << Qt::endl;
+	ts << tr("Document/vector handlers with color/palette import are marked in their capabilities above.") << Qt::endl;
+	Qt::endl(ts);
+
+	ts << tr("Built-in export formats") << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	ts << "- " << tr("Portable Document Format (PDF)") << Qt::endl;
+	ts << "  " << tr("Extensions: pdf") << Qt::endl;
+	ts << "  " << tr("Variants: PDF 1.3, PDF 1.4, PDF 1.5, PDF 1.6, PDF/X-1a, PDF/X-3, PDF/X-4") << Qt::endl;
+	ts << "- " << tr("Encapsulated PostScript (EPS)") << Qt::endl;
+	ts << "  " << tr("Extensions: eps") << Qt::endl;
+	ts << "- " << tr("Plain text") << Qt::endl;
+	ts << "  " << tr("Extensions: txt") << Qt::endl;
+	Qt::endl(ts);
+
+	const QStringList exportPluginNames = pluginManager->pluginNames(true, "ScActionPlugin");
+	ts << tr("Export plugins (%1)").arg(exportPluginNames.count()) << Qt::endl;
+	ts << QString(40, '-') << Qt::endl;
+	for (const QString& pluginName : exportPluginNames)
+	{
+		auto* actionPlugin = qobject_cast<ScActionPlugin*>(pluginManager->getPlugin(pluginName, true));
+		if (!actionPlugin || !actionPlugin->actionInfo().exportPlugin)
+			continue;
+		QString actionText = actionPlugin->actionInfo().text;
+		actionText.remove('&');
+		ts << "- " << actionPlugin->fullTrName() << Qt::endl;
+		ts << "  " << tr("Plugin: %1").arg(pluginName) << Qt::endl;
+		if (!actionText.isEmpty())
+			ts << "  " << tr("Action: %1").arg(actionText) << Qt::endl;
+		const ScPlugin::AboutData* about = actionPlugin->getAboutData();
+		if (about)
+		{
+			if (!about->shortDescription.isEmpty())
+				ts << "  " << tr("Summary: %1").arg(about->shortDescription) << Qt::endl;
+			if (!about->description.isEmpty())
+				ts << "  " << tr("Description: %1").arg(about->description) << Qt::endl;
+			if (!about->version.isEmpty())
+				ts << "  " << tr("Version: %1").arg(about->version) << Qt::endl;
+			actionPlugin->deleteAboutData(about);
+		}
+	}
+	ts << tr("Qt raster-image writer codecs: %1")
+		.arg(printableList(imageCodecNames(QImageWriter::supportedImageFormats()))) << Qt::endl;
+	Qt::endl(ts);
+	ts << tr("Note: a listed importer may still require an external helper or reject unsupported file variants.") << Qt::endl;
+}
