+static void show_formats( textout & log ) {
+	const std::vector<std::string> extensions = openmpt::get_supported_extensions();
+	std::size_t extension_width = MPT_USTRING( "Extension" ).length();
+	for ( const auto & extension : extensions ) {
+		extension_width = std::max( extension_width, extension.length() + 1 );
+	}
+
+	log << MPT_USTRING( "Extension" ) << mpt::ustring( extension_width - MPT_USTRING( "Extension" ).length() + 2, MPT_UCHAR( ' ' ) ) << MPT_USTRING( "Format" ) << lf;
+	log << mpt::ustring( extension_width, MPT_UCHAR( '-' ) ) << MPT_USTRING( "  ------" ) << lf;
+	for ( const auto & extension : extensions ) {
+		mpt::ustring names;
+		for ( const auto & description : module_format_descriptions ) {
+			if ( extension == description.extension ) {
+				if ( !names.empty() ) {
+					names += MPT_USTRING( "; " );
+				}
+				names += mpt::transcode<mpt::ustring>( mpt::source_encoding, description.name );
+			}
+		}
+		if ( names.empty() ) {
+			names = MPT_USTRING( "(format name unavailable)" );
+		}
+		const mpt::ustring dotted_extension = MPT_USTRING( "." ) + mpt::transcode<mpt::ustring>( libopenmpt_encoding, extension );
+		log << dotted_extension << mpt::ustring( extension_width - dotted_extension.length() + 2, MPT_UCHAR( ' ' ) ) << names << lf;
+	}
+	log.writeout();
+}
