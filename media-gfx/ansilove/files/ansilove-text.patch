diff --git a/src/text.c b/src/text.c
new file mode 100644
index 0000000..f1bd85b
--- /dev/null
+++ b/src/text.c
@@ -0,0 +1,160 @@
+/* Vibe coded by Codex
+ * ASCII stdout export. SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/stat.h>
+#include <ansilove.h>
+#include <err.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "config.h"
+#include "strtolower.h"
+#include "text.h"
+#include "types.h"
+
+static uint32_t
+little16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8;
+}
+
+static uint32_t
+little32(const uint8_t *p)
+{
+	return little16(p) | little16(p + 2) << 16;
+}
+
+int
+text_output(const char *input, const char *type, struct ansilove_options *options)
+{
+	struct ansilove_ctx ctx;
+	struct ansilove_options defaults;
+	struct stat st;
+	char *buffer = NULL, *extension = NULL;
+	size_t length = 0;
+	int format = 0, status = EXIT_FAILURE;
+	uint8_t data_type = 0, file_type = 0;
+	uint32_t sauce_columns = 0;
+	int (*loader)(struct ansilove_ctx *, struct ansilove_options *) = NULL;
+
+	if (type) {
+		for (size_t i = 0; i < TYPES; i++)
+			if (!strcmp(type, types[i]))
+				loader = loaders[i];
+		if (!loader) {
+			warnx("Unknown file type: %s", type);
+			return EXIT_FAILURE;
+		}
+	}
+	/* mmap cannot map an empty file; its searchable content is empty. */
+	if (stat(input, &st) == 0 && S_ISREG(st.st_mode) && !st.st_size)
+		return EXIT_SUCCESS;
+	if (ansilove_init(&ctx, &defaults) == -1)
+		return EXIT_FAILURE;
+	if (ansilove_loadfile(&ctx, input) == -1)
+		goto error;
+
+	/* Inspect the fixed footer directly: never index SAUCE or COMNT bytes. */
+	if (ctx.length >= 128 &&
+	    !memcmp(ctx.buffer + ctx.length - 128, "SAUCE", 5)) {
+		size_t end = ctx.length - 128;
+		const uint8_t *record = ctx.buffer + end;
+		size_t comments = record[104];
+		data_type = record[94];
+		file_type = record[95];
+		sauce_columns = little16(record + 96);
+		if (comments) {
+			size_t size = 5 + 64 * comments;
+			if (end < size) {
+				ctx.error = ANSILOVE_FORMAT_ERROR;
+				goto error;
+			}
+			end -= size;
+			if (memcmp(ctx.buffer + end, "COMNT", 5)) {
+				/* Some old files have a damaged comment marker. Accept
+				 * the boundary only if FileSize independently confirms it. */
+				size_t declared = little32(record + 90);
+				if (declared != end && !(declared < end &&
+				    end - declared == 1 && ctx.buffer[declared] == 26)) {
+					ctx.error = ANSILOVE_FORMAT_ERROR;
+					goto error;
+				}
+			}
+		}
+		/* The EOF separator is optional. FileSize can disambiguate a real
+		 * trailing 0x1a data byte in binary formats from a separator. */
+		if (end && ctx.buffer[end - 1] == 26 && little32(record + 90) != end)
+			end--;
+		ctx.length = end;
+	}
+
+	const char *dot = strrchr(input, '.');
+	extension = strdup(dot ? dot + 1 : "");
+	if (!extension) {
+		ctx.error = ANSILOVE_MEMORY_ERROR;
+		goto error;
+	}
+	strtolower(extension);
+	if (!loader) {
+		/* Recognize binary formats even when named .MEM or another suffix. */
+		if (ctx.length >= 5 && !memcmp(ctx.buffer, "XBIN\x1a", 5))
+			format = ANSILOVE_FILETYPE_XB;
+		else if (ctx.length >= 4 && !memcmp(ctx.buffer, "\x04" "1.4", 4))
+			format = ANSILOVE_FILETYPE_IDF;
+		else if (ctx.length >= 9 && !memcmp(ctx.buffer, "\x18" "TUNDRA24", 9))
+			format = ANSILOVE_FILETYPE_TND;
+		else {
+			for (size_t i = 0; i < TYPES; i++)
+				if (!strcmp(extension, types[i]))
+					format = filetypes[i];
+		}
+		if (!format) {
+			if (!strcmp(extension, "avt") || (data_type == 1 && file_type == 5)) {
+				warnx("Avatar text extraction is not supported.");
+				goto done;
+			}
+			if (data_type == 5)
+				format = ANSILOVE_FILETYPE_BIN;
+			else if (data_type == 6)
+				format = ANSILOVE_FILETYPE_XB;
+			else if (data_type == 1 && file_type == 4)
+				format = ANSILOVE_FILETYPE_PCB;
+			else if (data_type == 1 && file_type == 8)
+				format = ANSILOVE_FILETYPE_TND;
+			else
+				format = ANSILOVE_FILETYPE_ANS;
+		}
+		for (size_t i = 0; i < TYPES; i++)
+			if (format == filetypes[i])
+				loader = loaders[i];
+	}
+	if (!options->columns) {
+		/* SAUCE BinaryText stores half the column count in FileType. */
+		if (data_type == 5)
+			sauce_columns = (uint32_t)file_type * 2;
+		if ((data_type == 1 || data_type == 5) &&
+		    sauce_columns > 0 && sauce_columns <= 4096)
+			options->columns = sauce_columns;
+	}
+	options->diz = !strcmp(extension, "diz");
+	if (!ctx.length) {
+		status = EXIT_SUCCESS;
+		goto done;
+	}
+	if (ansilove_text(&ctx, options, loader, &buffer, &length) == -1)
+		goto error;
+	if (fwrite(buffer, 1, length, stdout) != length || fflush(stdout) == EOF) {
+		ctx.error = ANSILOVE_FILE_WRITE_ERROR;
+		goto error;
+	}
+	status = EXIT_SUCCESS;
+	goto done;
+error:
+	warnx("%s", ansilove_error(&ctx));
+done:
+	free(buffer);
+	free(extension);
+	ansilove_clean(&ctx);
+	return status;
+}
