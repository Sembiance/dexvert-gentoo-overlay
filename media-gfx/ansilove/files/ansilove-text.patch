@@ -0,0 +1,109 @@
+# Vibe coded by Codex
+"""CLI contract and metadata regression tests; uses only Python's standard library."""
+import pathlib
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+
+BINARY = str(pathlib.Path(sys.argv.pop(1)).resolve())
+
+
+def sauce(content, *, width=80, comments=0, eof=True, datatype=1, filetype=1):
+    record = bytearray(128)
+    record[:7] = b"SAUCE00"
+    record[7:42] = b"metadata_must_not_be_indexed".ljust(35)
+    struct.pack_into("<I", record, 90, len(content))
+    record[94:96] = bytes((datatype, filetype))
+    struct.pack_into("<H", record, 96, width)
+    record[104] = comments
+    trailer = b"COMNT" + b"comment_must_not_be_indexed".ljust(64) * comments if comments else b""
+    return content + (b"\x1a" if eof else b"") + trailer + record
+
+
+class TextOutput(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.root = pathlib.Path(self.directory.name)
+        self.addCleanup(self.directory.cleanup)
+
+    def run_file(self, content, *options, name="input.ans", expected=None):
+        path = self.root / name
+        path.write_bytes(content)
+        result = subprocess.run([BINARY, "-x", *options, str(path)], capture_output=True, timeout=10)
+        if expected is not None:
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stderr, b"")
+            self.assertEqual(result.stdout, expected)
+            self.assertTrue(all(c == 10 or 32 <= c <= 126 for c in result.stdout))
+            self.assertFalse(path.with_name(path.name + ".png").exists())
+        return result
+
+    def test_ascii_layout(self):
+        self.run_file(b"\x1b[31mLeft\xdbRight\x7fEnd\x1b[0m", expected=b"Left Right End\n")
+        self.run_file(b"old\x1b[1;1Hnew\x1b[5Cword", expected=b"new     word\n")
+        self.run_file(b"text\x1b[2J", expected=b"")
+        self.run_file(b"text", "-q", expected=b"text\n")
+        self.run_file(b"", expected=b"")
+
+    def test_sauce_comments_and_optional_eof(self):
+        for eof in (False, True):
+            for comments in (0, 1, 3):
+                with self.subTest(eof=eof, comments=comments):
+                    self.run_file(sauce(b"LAST", comments=comments, eof=eof), expected=b"LAST\n")
+        damaged = sauce(b"LAST", comments=1).replace(b"COMNT", b"\0" * 5)
+        self.run_file(damaged, expected=b"LAST\n")
+
+    def test_width_and_override(self):
+        data = sauce(b"ABCDEFGHIJKL", width=6)
+        self.run_file(data, expected=b"ABCDEF\nGHIJKL\n")
+        self.run_file(data, "-c", "4", expected=b"ABCD\nEFGH\nIJKL\n")
+        self.run_file(sauce(b"Hello", width=0), expected=b"Hello\n")
+        self.run_file(sauce(b"Hello", width=65535), expected=b"Hello\n")
+
+    def test_bad_metadata_and_arguments(self):
+        data = bytearray(sauce(b"Hello"))
+        data[-24] = 255
+        result = self.run_file(data)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, b"")
+        for options in (("-s",), ("-o", str(self.root / "unwanted.png")), ("-t", "unknown")):
+            result = self.run_file(b"Hello", *options)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertEqual(result.stdout, b"")
+        for args in (["-x"], ["-x", str(self.root / "absent.ans")]):
+            result = subprocess.run([BINARY, *args], capture_output=True, timeout=10)
+            self.assertNotEqual(result.returncode, 0)
+            self.assertEqual(result.stdout, b"")
+        result = self.run_file(b"\x16\x01\x07Hello", name="input.avt")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, b"")
+
+    def test_binary_and_signature_detection(self):
+        pairs = b"H\x07e\x07l\x07l\x07o\x07"
+        self.run_file(sauce(pairs + b" \x07" * 5, datatype=5, filetype=5), name="input.data", expected=b"Hello\n")
+        xb = b"XBIN\x1a" + struct.pack("<HHBB", 5, 1, 16, 0) + pairs
+        self.run_file(xb, name="input.data", expected=b"Hello\n")
+        # Every XBin run-length encoding: literal, character, attribute, both.
+        for flags, encoded, expected in ((0, pairs, b"Hello\n"),
+                (4, b"\x04" + pairs, b"Hello\n"),
+                (4, b"\x44Z" + b"\x07" * 5, b"ZZZZZ\n"),
+                (4, b"\x84\x07Hello", b"Hello\n"),
+                (4, b"\xc4Z\x07", b"ZZZZZ\n")):
+            xb = b"XBIN\x1a" + struct.pack("<HHBB", 5, 1, 16, flags) + encoded
+            self.run_file(xb, name="input.data", expected=expected)
+        self.run_file(b"@X07Hello", name="input.PCB", expected=b"Hello\n")
+
+    @unittest.skipUnless(pathlib.Path("/dev/full").exists(), "requires /dev/full")
+    def test_stdout_write_failure(self):
+        path = self.root / "input.ans"
+        path.write_bytes(b"Hello")
+        with open("/dev/full", "wb") as sink:
+            result = subprocess.run([BINARY, "-x", str(path)], stdout=sink, stderr=subprocess.PIPE, timeout=10)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertTrue(result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
