From bf1e1fffccec7b9a187d29f5143a966c5a9644e3 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 8 Aug 2026 09:19:33 -0400
Subject: [PATCH] Add format listing and forced decoding support

Adds --list, --verbose, and --format=ID[,ID...] to recoil2png, tracks ambiguous decoder format IDs in the core, and generates the CLI format catalog from formats.xml.
---
 Makefile           |   8 +-
 formats-list.h.xsl |  43 ++++
 formats.xml        | 224 +++++++++---------
 recoil.fu          | 577 +++++++++++++++++++++++++++++++++++++--------
 recoil2png.c       | 247 ++++++++++++++++++-
 5 files changed, 883 insertions(+), 216 deletions(-)
 create mode 100644 formats-list.h.xsl

diff --git a/Makefile b/Makefile
index 27d1a38..8d933ac 100644
--- a/Makefile
+++ b/Makefile
@@ -1,3 +1,4 @@
+# Vibe coded by Codex
 PREFIX = /usr/local
 XNVIEW = /opt/XnView
 MAGICK_VERSION     := $(shell MagickCore-config --version 2>/dev/null)
@@ -20,7 +21,7 @@ INSTALL_DATA = $(INSTALL) -m 644
 
 all: recoil2png $(if $(CAN_INSTALL_MAGICK),imagemagick/recoil.so) recoil-mime.xml
 
-recoil2png: recoil2png.c pngsave.c pngsave.h recoil-stdio.c recoil-stdio.h recoil.c recoil.h
+recoil2png: recoil2png.c pngsave.c pngsave.h recoil-stdio.c recoil-stdio.h recoil.c recoil.h formats-list.h
 	$(CC) $(CFLAGS) recoil2png.c pngsave.c recoil-stdio.c recoil.c -lpng -lz -o $@
 
 file-recoil: file-recoil.c recoil-stdio.c recoil-stdio.h recoil.c recoil.h formats.h
@@ -41,6 +42,9 @@ endif
 formats.h: formats.h.xsl formats.xml
 	xsltproc -o $@ formats.h.xsl formats.xml
 
+formats-list.h: formats-list.h.xsl formats.xml
+	xsltproc -o $@ formats-list.h.xsl formats.xml
+
 # http://www.cmcrossroads.com/article/rules-multiple-outputs-gnu-make
 %.c %.h: %.fu altirrantsc.pal altirrapal.pal atari8.fnt c16.pal c64.fnt zx81.fnt
 	$(FUT) -o $*.c $<
@@ -49,7 +53,7 @@ benchmark: benchmark.c recoil-stdio.c recoil-stdio.h recoil.c recoil.h
 	$(CC) $(CFLAGS) benchmark.c recoil-stdio.c recoil.c -o $@
 
 clean:
-	rm -f recoil2png file-recoil imagemagick/recoil.so imagemagick/coder.xml.new formats.h recoil-mime.xml benchmark Xrecoil.usr
+	rm -f recoil2png file-recoil imagemagick/recoil.so imagemagick/coder.xml.new formats.h formats-list.h recoil-mime.xml benchmark Xrecoil.usr
 
 install: install-thumbnailer $(if $(CAN_INSTALL_MAGICK),install-magick)
 
diff --git a/formats-list.h.xsl b/formats-list.h.xsl
new file mode 100644
index 0000000..0c57bdf
--- /dev/null
+++ b/formats-list.h.xsl
@@ -0,0 +1,43 @@
+<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" version="1.0">
+	<!-- Vibe coded by Codex -->
+	<xsl:output method="text" />
+	<xsl:template match="/formats">
+		<xsl:text>/* Generated automatically from formats.xml and formats-list.h.xsl. Do not edit. */&#10;/* Vibe coded by Codex */&#10;&#10;</xsl:text>
+		<xsl:text>typedef struct {&#10;</xsl:text>
+		<xsl:text>&#9;const char *ext;&#10;</xsl:text>
+		<xsl:text>&#9;const char *formatId;&#10;</xsl:text>
+		<xsl:text>&#9;const char *platform;&#10;</xsl:text>
+		<xsl:text>&#9;const char *name;&#10;</xsl:text>
+		<xsl:text>} RecoilFormatInfo;&#10;&#10;</xsl:text>
+		<xsl:text>static const RecoilFormatInfo recoil_formats[] = {&#10;</xsl:text>
+		<xsl:for-each select="platform/format/ext">
+			<xsl:sort select="../../@name" />
+			<xsl:sort select="." />
+			<xsl:text>&#9;{ "</xsl:text>
+			<xsl:value-of select="." />
+			<xsl:text>", "</xsl:text>
+			<xsl:choose>
+				<xsl:when test="@formatId">
+					<xsl:value-of select="@formatId" />
+				</xsl:when>
+				<xsl:otherwise>
+					<xsl:value-of select="." />
+				</xsl:otherwise>
+			</xsl:choose>
+			<xsl:text>", "</xsl:text>
+			<xsl:value-of select="../../@name" />
+			<xsl:text>", "</xsl:text>
+			<xsl:choose>
+				<xsl:when test="../@name">
+					<xsl:value-of select="../@name" />
+				</xsl:when>
+				<xsl:otherwise>
+					<xsl:value-of select="." />
+				</xsl:otherwise>
+			</xsl:choose>
+			<xsl:text>" },&#10;</xsl:text>
+		</xsl:for-each>
+		<xsl:text>};&#10;&#10;</xsl:text>
+		<xsl:text>static const int recoil_format_count = sizeof(recoil_formats) / sizeof(recoil_formats[0]);&#10;</xsl:text>
+	</xsl:template>
+</xsl:stylesheet>
