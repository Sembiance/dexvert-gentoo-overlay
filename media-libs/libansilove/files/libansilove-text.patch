@@ -0,0 +1,25 @@
+/* Vibe coded by Codex */
+#ifndef ANSILOVE_TEXT_INTERNAL_H
+#define ANSILOVE_TEXT_INTERNAL_H
+
+#include <gd.h>
+#include "ansilove.h"
+
+/* Private flag: only ansilove_text() may set this on its local options. */
+#define TEXT_MODE 0x80
+#define TEXT_MAX_BYTES (64U * 1024U * 1024U)
+
+/* The initial member permits passing this private context to existing loaders.
+ * No public structure layout changes, global state, or TLS are required. */
+struct text_context {
+	struct ansilove_ctx ctx;
+	gdImagePtr canvas;
+	char *cells;
+	size_t columns;
+	size_t rows;
+};
+
+gdImagePtr create_canvas(struct ansilove_ctx *, struct ansilove_options *,
+    uint32_t, uint32_t, uint32_t, uint32_t, bool);
+
+#endif
