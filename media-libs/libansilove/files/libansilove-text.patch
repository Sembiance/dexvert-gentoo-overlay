diff --git a/src/text.c b/src/text.c
new file mode 100644
index 0000000..888cff6
--- /dev/null
+++ b/src/text.c
@@ -0,0 +1,97 @@
+/* Vibe coded by Codex
+ * ASCII extraction using the same character placements as the PNG loaders.
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <stdlib.h>
+#include <string.h>
+#include "text.h"
+
+gdImagePtr
+create_canvas(struct ansilove_ctx *ctx, struct ansilove_options *options,
+    uint32_t width, uint32_t height, uint32_t bits, uint32_t font_height,
+    bool truecolor)
+{
+	if (!(options->mode & TEXT_MODE))
+		return truecolor ? gdImageCreateTrueColor(width, height) :
+		    gdImageCreate(width, height);
+
+	struct text_context *text = (struct text_context *)ctx;
+	if (!bits || !font_height || width < bits || height < font_height)
+		return NULL;
+	text->columns = width / bits;
+	text->rows = height / font_height;
+	size_t stride = text->columns + 1;
+	/* Include room for newlines and a terminating NUL; bound large inputs. */
+	if (text->rows > (TEXT_MAX_BYTES - 1) / stride)
+		return NULL;
+	text->cells = malloc(text->rows * stride + 1);
+	if (!text->cells)
+		return NULL;
+	memset(text->cells, ' ', text->rows * stride);
+
+	/* Retain GD's palette handling, without allocating a full pixel image. */
+	text->canvas = truecolor ? gdImageCreateTrueColor(1, 1) :
+	    gdImageCreate(1, 1);
+	return text->canvas;
+}
+
+int
+ansilove_text(struct ansilove_ctx *ctx, const struct ansilove_options *options,
+    int (*loader)(struct ansilove_ctx *, struct ansilove_options *),
+    char **buffer, size_t *length)
+{
+	if (buffer)
+		*buffer = NULL;
+	if (length)
+		*length = 0;
+	if (!ctx || !options || !buffer || !length ||
+	    (options->mode & TEXT_MODE) ||
+	    (loader != ansilove_ansi && loader != ansilove_artworx &&
+	    loader != ansilove_binary && loader != ansilove_icedraw &&
+	    loader != ansilove_pcboard && loader != ansilove_tundra &&
+	    loader != ansilove_xbin)) {
+		if (ctx)
+			ctx->error = ANSILOVE_INVALID_PARAM;
+		return -1;
+	}
+
+	struct text_context text = {0};
+	struct ansilove_options local_options = *options;
+	text.ctx = *ctx;
+	text.ctx.error = 0;
+	text.ctx.png.buffer = NULL;
+	text.ctx.png.length = 0;
+	local_options.mode |= TEXT_MODE;
+	int status = loader(&text.ctx, &local_options);
+	if (status == 0 && !text.cells) {
+		text.ctx.error = ANSILOVE_FORMAT_ERROR;
+		status = -1;
+	}
+	if (status == 0) {
+		size_t used = 0, last_nonempty = 0;
+		const size_t stride = text.columns + 1;
+		for (size_t row = 0; row < text.rows; row++) {
+			char *line = text.cells + row * stride;
+			size_t end = text.columns;
+			while (end && line[end - 1] == ' ')
+				end--;
+			/* Drop leading/trailing blank rows, retain internal spacing. */
+			if (!end && !used)
+				continue;
+			memmove(text.cells + used, line, end);
+			used += end;
+			text.cells[used++] = '\n';
+			if (end)
+				last_nonempty = used;
+		}
+		text.cells[last_nonempty] = '\0';
+		*buffer = text.cells;
+		*length = last_nonempty;
+	} else {
+		free(text.cells);
+	}
+	if (text.canvas)
+		gdImageDestroy(text.canvas);
+	ctx->error = text.ctx.error;
+	return status;
+}
