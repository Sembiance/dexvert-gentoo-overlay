@@ -0,0 +1,75 @@
+/* Vibe coded by Codex */
+#include <ansilove.h>
+#include <gd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(expr) do { if (!(expr)) { \
+	fprintf(stderr, "line %d: %s\n", __LINE__, #expr); exit(1); \
+} } while (0)
+
+static void
+check_text(const char *input, const char *expected,
+    int (*loader)(struct ansilove_ctx *, struct ansilove_options *))
+{
+	struct ansilove_ctx ctx;
+	struct ansilove_options options, before;
+	char *text = NULL;
+	size_t size = 0;
+	CHECK(ansilove_init(&ctx, &options) == 0);
+	ctx.buffer = (uint8_t *)input;
+	ctx.length = strlen(input);
+	before = options;
+	CHECK(ansilove_text(&ctx, &options, loader, &text, &size) == 0);
+	CHECK(size == strlen(expected));
+	CHECK(!strcmp(text, expected));
+	CHECK(!memcmp(&options, &before, sizeof(options)));
+	CHECK(ctx.png.buffer == NULL);
+	for (size_t i = 0; i < size; i++)
+		CHECK(text[i] == '\n' || (text[i] >= 32 && text[i] <= 126));
+	free(text);
+}
+
+int
+main(void)
+{
+	check_text("\033[31mHello\033[0m", "Hello\n", ansilove_ansi);
+	check_text("left\333right\177end", "left right end\n", ansilove_ansi);
+	check_text("A\033[3CB", "A   B\n", ansilove_ansi);
+	check_text("old\033[1;1Hnew", "new\n", ansilove_ansi);
+	check_text("A\033[1;1H\333", "", ansilove_ansi);
+	check_text("old\033[2Jnew", "new\n", ansilove_ansi);
+	check_text("old\033[2J", "", ansilove_ansi);
+	check_text("\r\n\r\n  first  \r\n\r\nsecond   \r\n\r\n",
+	    "  first\n\nsecond\n", ansilove_ansi);
+	check_text("\033[30;40mhidden\033[37mvisible", "      visible\n", ansilove_ansi);
+	check_text("@X07old@CLS@@X0FHello", "Hello\n", ansilove_pcboard);
+	check_text("left\007right", "left right\n", ansilove_ansi);
+
+	/* Existing PNG buffers and caller options survive multiple text renders. */
+	struct ansilove_ctx ctx;
+	struct ansilove_options options;
+	char *text;
+	size_t size;
+	CHECK(ansilove_init(&ctx, &options) == 0);
+	ctx.buffer = (uint8_t *)"Hello";
+	ctx.length = 5;
+	CHECK(ansilove_ansi(&ctx, &options) == 0);
+	uint8_t *png = ctx.png.buffer;
+	int png_length = ctx.png.length;
+	for (int i = 0; i < 2; i++) {
+		CHECK(ansilove_text(&ctx, &options, ansilove_ansi, &text, &size) == 0);
+		CHECK(size == 6 && !strcmp(text, "Hello\n"));
+		CHECK(ctx.png.buffer == png && ctx.png.length == png_length);
+		CHECK(!memcmp(png, "\211PNG\r\n\032\n", 8));
+		free(text);
+	}
+	CHECK(ansilove_text(&ctx, &options, NULL, &text, &size) == -1);
+	CHECK(text == NULL && size == 0 && ctx.error == ANSILOVE_INVALID_PARAM);
+	ctx.length = 0;
+	CHECK(ansilove_text(&ctx, &options, ansilove_ansi, &text, &size) == -1);
+	CHECK(text == NULL && size == 0);
+	gdFree(png);
+	return 0;
+}
