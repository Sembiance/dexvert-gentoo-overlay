--- a/libxad/clients/AMPK.c
+++ b/libxad/clients/AMPK.c
@@ -1,6 +1,8 @@
 #ifndef XADMASTER_AMPK_C
 #define XADMASTER_AMPK_C
 
+/* Vibe coded by Codex */
+
 /*  $Id: AMPK.c,v 1.16 2005/06/23 14:54:40 stoecker Exp $
     AmiPack file archiver
 
@@ -1594,8 +1596,43 @@
       return XADERR_CHECKSUM;
     bits = (1<<22)-1;
   }
-  else if(xadCalcCRC32(XADM XADCRC32_ID1, 0, endpos, (xadUINT8 *) data) != EndGetM32(lhw->crc32))
-    return XADERR_CHECKSUM;
+  else
+  {
+    xadUINT32 expected = EndGetM32(lhw->crc32);
+    if(xadCalcCRC32(XADM XADCRC32_ID1, 0, endpos, (xadUINT8 *) data) != expected)
+    {
+      /* LhWarp before 1.30 could encode stale sector labels or a stray byte
+      in the final sector. Only accept a repair when the archive's stored CRC
+      proves the corrected track. */
+      if((uintptr_t)ai->xai_CurDisk->xdi_PrivateInfo < 3 && endpos >= blksize)
+      {
+        xadINT32 repaired = 0;
+        for(i = 512; i+16 <= endpos; i += blksize)
+          memset(data+i, 0, 16);
+        if(xadCalcCRC32(XADM XADCRC32_ID1, 0, endpos, (xadUINT8 *) data) == expected)
+          repaired = 1;
+        else
+        {
+          for(i = endpos-blksize; i < endpos-16 && !repaired; ++i)
+          {
+            xadUINT8 byte = data[i];
+            if(byte)
+            {
+              data[i] = 0;
+              if(xadCalcCRC32(XADM XADCRC32_ID1, 0, endpos, (xadUINT8 *) data) == expected)
+                repaired = 1;
+              else
+                data[i] = byte;
+            }
+          }
+        }
+        if(!repaired)
+          return XADERR_CHECKSUM;
+      }
+      else
+        return XADERR_CHECKSUM;
+    }
+  }
 
   if(bits < (1<<22)-1) /* if equal, no copy necessary */
   {
